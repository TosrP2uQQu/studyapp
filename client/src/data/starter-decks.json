    "id": "lt-grammar-cases",
    "name": "Lithuanian grammar: 7 cases",
    "subject": "Lietuvių kalba",
    "type": "general",
    "description": "The seven Lithuanian cases with their questions and one canonical example each. Standard grammar; general knowledge.",
    "cards": [
      { "front": "vardininkas", "back": "nominative — the subject. Question: kas? (who? what?)" },
      { "front": "kilmininkas", "back": "genitive — possession. Question: ko? (of whom? of what?)" },
      { "front": "naudininkas", "back": "dative — the recipient. Question: kam? (to whom?)" },
      { "front": "galininkas", "back": "accusative — the object. Question: ką? (whom? what?)" },
      { "front": "įnagininkas", "back": "instrumental — the means. Question: kuo? (with what?)" },
      { "front": "vietininkas", "back": "locative — the place. Question: kur? (where?)" },
      { "front": "šauksmininkas", "back": "vocative — addressing someone. Used for names and calls." },
      { "front": "draugas → draugo", "back": "kilmininkas of friend: of a friend" },
      { "front": "knyga → knygai", "back": "naudininkas of book: to/for a book" },
      { "front": "pienas → pieną", "back": "galininkas of milk: milk (as object)" },
      { "front": "vanduo → vandeniu", "back": "įnagininkas of water: with water" },
      { "front": "Vilnius → Vilniuje", "back": "vietininkas of Vilnius: in Vilnius" },
      { "front": "Jonas → Jonai", "back": "šauksmininkas of Jonas: hey Jonas!" },
      { "front": "mama (kas?)", "back": "vardininkas: mama is the subject" },
      { "front": "Name all seven in order", "back": "vardininkas, kilmininkas, naudininkas, galininkas, įnagininkas, vietininkas, šauksmininkas" }
    ]
  },
